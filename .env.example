# Copy this file to .env and fill in your own values. Never commit .env.

# Google Places API (New) key — see README for setup steps
GOOGLE_PLACES_API_KEY=

# SendGrid API key — see README for setup steps
SENDGRID_API_KEY=

# The email address and name your campaigns send from.
# The sender email must be a "verified sender" in SendGrid before sending will work.
SENDER_EMAIL=you@yourcompany.com
SENDER_NAME=Your Company

# Required by CAN-SPAM/POPIA-style rules: a real physical address for your business,
# shown in every email footer.
SENDER_PHYSICAL_ADDRESS=123 Main Street, Johannesburg, South Africa

# Used to generate unsubscribe links. Set this to any random string.
APP_SECRET=change-this-to-a-random-string

# The base URL where this app runs (used in unsubscribe links). Change if you deploy it.
APP_BASE_URL=http://localhost:5000
